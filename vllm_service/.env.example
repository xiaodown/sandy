# Local vLLM service configuration.
# Copy to .env and edit there. .env is intentionally gitignored.

# The OpenAI-compatible model id exposed to Sandy/Open WebUI/etc.
VLLM_BRAIN_SERVED_MODEL_NAME="sandy-brain"

# Example Qwen3.6 NVFP4 profile.
VLLM_BRAIN_MODEL="unsloth/Qwen3.6-27B-NVFP4"
VLLM_BRAIN_MAX_MODEL_LEN=65536
VLLM_BRAIN_ENABLE_MTP=true

# Example Mistral fallback profile.
# VLLM_BRAIN_MODEL="mistralai/Mistral-Small-4-119B-2603-NVFP4"
# VLLM_BRAIN_MAX_MODEL_LEN=16384
# VLLM_BRAIN_ENABLE_MTP=false

# Let run.sh infer family-specific flags. Override only when debugging.
VLLM_BRAIN_PROFILE=auto

# Bind only to localhost by default. Put a reverse proxy in front if exposing it.
VLLM_BRAIN_HOST=127.0.0.1
VLLM_BRAIN_PORT=8000

# CUDA device index or UUID. Keep machine-specific UUIDs in your local .env.
VLLM_BRAIN_CUDA_VISIBLE_DEVICES=0
VLLM_BRAIN_GPU_MEMORY_UTILIZATION=0.88

# Optional local paths. Defaults shown here match the service scripts.
VLLM_BRAIN_LOG_FILE="./logs/vllm-brain.log"
VLLM_BRAIN_PID_FILE="./vllm-brain.pid"

# Advanced overrides. Usually leave these unset and let the profile decide.
# VLLM_BRAIN_ATTENTION_BACKEND=
# VLLM_BRAIN_REASONING_PARSER=
# VLLM_BRAIN_TOOL_PARSER=
# VLLM_BRAIN_GENERATION_CONFIG=vllm
# VLLM_BRAIN_DEFAULT_CHAT_TEMPLATE_KWARGS=
# VLLM_BRAIN_SPECULATIVE_CONFIG=
# For Open WebUI image uploads with a multimodal model, disable text-only mode
# and allow image inputs explicitly. This costs extra VRAM/runtime overhead.
# VLLM_BRAIN_LANGUAGE_MODEL_ONLY=false
# VLLM_BRAIN_LIMIT_MM_PER_PROMPT='{"image":1,"video":0}'
# VLLM_BRAIN_MM_PROCESSOR_KWARGS=
# VLLM_BRAIN_EXTRA_ARGS=
